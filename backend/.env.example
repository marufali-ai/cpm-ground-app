# Copy to .env and adjust. All keys are prefixed CPM_.

CPM_ENVIRONMENT=development

# SQLite by default (zero setup). For Postgres (PRD 59):
# CPM_DATABASE_URL=postgresql+psycopg://cpm:cpm@localhost:5432/cpm
CPM_DATABASE_URL=sqlite:///./data/cpm.db

# CHANGE THIS in any shared/staging/production environment.
CPM_JWT_SECRET=dev-only-change-me-in-production
CPM_ACCESS_TTL_MIN=30
CPM_REFRESH_TTL_DAYS=14
CPM_OTP_TTL_MIN=5
# Return the OTP in the login response for testing. MUST be false in production.
CPM_EXPOSE_OTP=true

# Evidence object storage (PRD 48, 60, 74). Local disk by default; swap for S3/MinIO.
CPM_STORAGE_DIR=./data/objects
CPM_SIGNED_URL_TTL_SEC=600
CPM_MAX_UPLOAD_MB=25

# Field defaults, overridable per-center / via /admin/config (PRD 116)
CPM_DEFAULT_GEOFENCE_M=50
CPM_DEFAULT_MAX_PHOTOS=5

CPM_CORS_ORIGINS=*
CPM_SEED_ON_START=true
